import pandas as pd

df = pd.read_csv('demo/legu419_input.csv')

# 清洗序列
df['sequence'] = df['sequence'].apply(lambda x: ''.join(x.split()))

# 检查清洗后是否还有问题
pdb_groups = df.groupby('pdbpath')['sequence'].apply(set)
for pdb, seqs in pdb_groups.items():
    if len(seqs) > 1:
        print(f"❌ {pdb} 仍有不同序列")
        for i, seq in enumerate(seqs):
            print(f"  序列{i+1}: {seq[:50]}...")
    else:
        print(f"✅ {pdb} 序列一致")

# 保存清洗后的 CSV
df.to_csv('demo/legu419_input_clean.csv', index=False)
print("\n已保存清洗后的 CSV: demo/legu419_input_clean.csv")
