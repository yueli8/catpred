#generate protein JSON file
(catpred) li@li-ThinkStation-P3-Tower-Gen-2:~/CatPred-main$ python << 'EOF'
import json
import pandas as pd

df = pd.read_csv('demo/legu419_input.csv')

# 清洗序列
df['sequence'] = df['sequence'].apply(lambda x: ''.join(x.split()))

# 去重，每个 pdbpath 只保留一条
unique_proteins = df[['pdbpath', 'sequence']].drop_duplicates(subset='pdbpath')

records = {}
for _, row in unique_proteins.iterrows():
    records[row['pdbpath']] = {
        'seq': row['sequence'],
        'pdbpath': row['pdbpath']
    }

# 直接保存到当前目录（与命令中的路径一致）
with open('legu02_protein.json', 'w') as f:
    json.dump(records, f, indent=2)

print(f"✅ 已创建 {len(records)} 个蛋白质记录")
for key in records:
    print(f"  {key}: 序列长度 {len(records[key]['seq'])}")
EOF

